# Apache/LiteSpeed config for the exported web build (Hostinger and similar).
# Files in app/public/ are copied verbatim into dist/ by `expo export`, so this
# ships with every build rather than having to be re-added on the server.

# ---------------------------------------------------------------------------
# Routing
# ---------------------------------------------------------------------------
# Today NavigationContainer has no `linking` config, so the app never leaves "/"
# and these rules are inert. They're here because the moment a linking config is
# added (which is what makes URLs shareable), index.html is still the only HTML
# file on disk — and every deep link and refresh would 404 without a rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Order matters — these pass-throughs must come before the catch-all below.

  # ACME HTTP-01 challenges, or SSL certificate renewal fails and the site
  # silently drops to plain HTTP.
  RewriteRule ^\.well-known/ - [L]

  # The API must reach the Node process, never index.html.
  RewriteRule ^api(/.*)?$ - [L]

  # Anything that exists on disk (the JS bundle, assets, favicon) is served
  # as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is an app route: hand it to the SPA.
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
# helmet() only sets these on responses from the Express API. These static
# files are served by Apache, which applies none of it.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS is only meaningful over HTTPS, and it instructs browsers to refuse
  # plain HTTP to this host for a year — the condition keeps it off until TLS
  # is actually serving.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # connect-src covers Supabase (REST + auth over HTTPS, realtime over wss) and
  # 'self' for the same-origin /api calls. Google Maps needs its script, image,
  # and font origins. 'unsafe-inline' in style-src is unavoidable:
  # react-native-web injects styles into the document at runtime.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com https://*.ggpht.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://maps.googleapis.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# ---------------------------------------------------------------------------
# Exposure
# ---------------------------------------------------------------------------
# No directory listings — and note that a directory with neither a listing nor
# an index is what produced the original 403.
Options -Indexes

# Don't serve dotfiles. Concretely: the deploy action writes
# .ftp-deploy-sync-state.json into the web root, which enumerates every
# deployed file. FTP reads and writes it normally; this only blocks HTTP.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Bundle and asset filenames contain content hashes, so they're immutable and
# can be cached hard. index.html must NOT be, or browsers keep loading the
# previous bundle after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
