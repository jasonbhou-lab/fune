# Copy this file to .env (same folder) and fill in real values from your
# Supabase project (Project Settings > API). Never commit .env — it's already
# listed in .gitignore.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key — full access, bypasses Row Level Security. Server-side
# only. Never expose this to the frontend or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# Port for the Express API. Defaults to 4000.
PORT=

# ---------------------------------------------------------------------------
# Security settings — all optional in local development, all worth setting in
# production.
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call this API. Leaving it
# blank allows every origin, which is fine on a laptop and not fine on the
# internet.
#   CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=

# Number of reverse proxies in front of this server (or an Express
# "trust proxy" value). Required for rate limiting to see real client IPs when
# running behind nginx / Passenger / Cloudflare / a load balancer — a single
# hop is usually "1". Leave BLANK when the server is directly internet-facing:
# trusting X-Forwarded-For that no proxy set lets clients forge their own IP
# and bypass the rate limits entirely.
TRUST_PROXY=

# Require a second factor (Supabase aal2) for platform_admin accounts, matching
# what provider owners/administrators already have to do. Set to true only
# after those accounts have actually enrolled MFA in Supabase — otherwise they
# will be locked out of the admin back office.
REQUIRE_ADMIN_MFA=
